@{
    ViewData["Title"] =
        "Inventory Management System Case Study | M.H.A";

    ViewData["Description"] =
        "Explore M.H.A's ASP.NET Core inventory management system for products, suppliers, categories, stock levels and business inventory reporting.";
}

<section class="case-study-hero inventory-case-study-hero">
    <div class="case-study-hero-inner">

        <p class="section-label">CASE STUDY / BUSINESS SOFTWARE</p>

        <h1>
            INVENTORY
            <span>MANAGEMENT SYSTEM.</span>
        </h1>

        <p class="case-study-intro">
            A full-stack inventory and operations platform built to manage
            products, suppliers, purchasing, sales, stock levels and reporting
            through one structured business system.
        </p>

        <div class="case-study-meta">
            <div>
                <span>TYPE</span>
                <strong>Business Software</strong>
            </div>

            <div>
                <span>STACK</span>
                <strong>ASP.NET Core MVC / C# / SQL Server</strong>
            </div>

            <div>
                <span>FOCUS</span>
                <strong>Inventory / Sales / Purchasing</strong>
            </div>
        </div>

    </div>
</section>


<section class="case-study-featured-image reveal">
    <div class="case-study-image-frame">
        <img src="~/images/portfolio/inventory/inventory-dashboard.png"
             alt="Inventory Management System dashboard" />
    </div>
</section>


<section class="case-study-section">
    <div class="case-study-two-column">

        <div class="case-study-number">
            01
        </div>

        <div class="case-study-copy reveal">
            <p class="section-label">OVERVIEW</p>

            <h2>
                ONE SYSTEM FOR CORE BUSINESS OPERATIONS.
            </h2>

            <p>
                The Inventory Management System was designed as a centralised
                platform for managing inventory-related business processes.
                Instead of separating stock, purchasing, sales and reporting
                across different workflows, the application brings these
                functions together inside one operational environment.
            </p>

            <p>
                The system gives users visibility over stock quantities,
                inventory value, supplier activity, sales revenue and
                purchasing activity while providing structured workflows for
                maintaining the underlying business data.
            </p>
        </div>

    </div>
</section>


<section class="case-study-section case-study-dark">
    <div class="case-study-two-column">

        <div class="case-study-number">
            02
        </div>

        <div class="case-study-copy reveal">
            <p class="section-label">THE PROBLEM</p>

            <h2>
                INVENTORY BECOMES HARD TO CONTROL WHEN DATA IS FRAGMENTED.
            </h2>

            <p>
                Businesses handling stock need more than a basic product list.
                They need to understand what is available, what needs to be
                reordered, where stock comes from, what has been sold and how
                those activities affect the wider operation.
            </p>

            <p>
                The platform addresses that problem by connecting products,
                categories, suppliers, purchase orders, sales and reporting
                through a shared data model.
            </p>
        </div>

    </div>
</section>


<section class="case-study-section">
    <div class="case-study-two-column">

        <div class="case-study-number">
            03
        </div>

        <div class="case-study-copy reveal">
            <p class="section-label">CORE CAPABILITIES</p>

            <h2>
                BUILT AROUND REAL OPERATIONAL WORKFLOWS.
            </h2>

            <div class="case-study-feature-grid">

                <article class="case-study-feature-card">
                    <span>01</span>
                    <h3>Inventory Management</h3>
                    <p>
                        Manage products, pricing, quantities, reorder levels,
                        categories, suppliers and product status.
                    </p>
                </article>

                <article class="case-study-feature-card">
                    <span>02</span>
                    <h3>Stock Monitoring</h3>
                    <p>
                        Identify low-stock and out-of-stock products and surface
                        stock attention directly on the dashboard.
                    </p>
                </article>

                <article class="case-study-feature-card">
                    <span>03</span>
                    <h3>Purchasing</h3>
                    <p>
                        Create supplier purchase orders, add items and track
                        order status through purchasing workflows.
                    </p>
                </article>

                <article class="case-study-feature-card">
                    <span>04</span>
                    <h3>Sales</h3>
                    <p>
                        Create customer sales, generate invoice records and
                        track revenue through searchable sales history.
                    </p>
                </article>

                <article class="case-study-feature-card">
                    <span>05</span>
                    <h3>Reporting</h3>
                    <p>
                        Access inventory value, low-stock, sales, revenue and
                        top-selling product reports.
                    </p>
                </article>

                <article class="case-study-feature-card">
                    <span>06</span>
                    <h3>Authentication</h3>
                    <p>
                        Secure application access through ASP.NET Core Identity
                        and authenticated user sessions.
                    </p>
                </article>

            </div>
        </div>

    </div>
</section>


